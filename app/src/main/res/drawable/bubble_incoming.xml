<?xml version="1.0" encoding="utf-8"?>
<!--
  Incoming bubble: dark surface, 2dp left-edge accent strip (white/dim)
  Asymmetric corners: more rounded on all except bottom-left
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left accent bar -->
    <item android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#242424" />
            <corners
                android:topLeftRadius="4dp"
                android:bottomLeftRadius="4dp"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- Bubble body -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#111111" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
