<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:background="@drawable/chat_row_selector">

    <!-- Avatar Circle -->
    <FrameLayout
        android:id="@+id/layout_avatar"
        android:layout_width="50dp"
        android:layout_height="50dp">

        <TextView
            android:id="@+id/tv_avatar_letter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="4dp">

        <!-- Name & Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_chat_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_chat_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_meta"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Preview & Unread Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <!-- Checkmarks for outgoing preview -->
            <TextView
                android:id="@+id/tv_preview_ticks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_ticks_blue"
                android:textSize="13sp"
                android:layout_marginRight="4dp"
                android:text="&#10003;&#10003;"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_chat_last_msg"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_sub"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_unread_badge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="18dp"
                android:background="@drawable/badge_unread"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
