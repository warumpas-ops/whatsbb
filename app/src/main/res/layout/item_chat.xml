<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:background="@drawable/chat_row_selector">

    <!-- Contact Name -->
    <TextView
        android:id="@+id/tv_chat_name"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textColor="#E0E2E6"
        android:textSize="15sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tv_chat_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#555A64"
        android:textSize="12sp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="8dp" />

    <!-- Red Dot for Unread Messages (small crisp circle) -->
    <TextView
        android:id="@+id/tv_unread_badge"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/red_dot"
        android:visibility="gone" />

    <!-- Hidden compatibility stubs -->
    <FrameLayout
        android:id="@+id/layout_avatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageView android:id="@+id/iv_avatar" android:layout_width="0dp" android:layout_height="0dp"/>
        <TextView android:id="@+id/tv_avatar_letter" android:layout_width="0dp" android:layout_height="0dp"/>
    </FrameLayout>
    <TextView android:id="@+id/tv_preview_ticks" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tv_chat_last_msg" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</LinearLayout>
