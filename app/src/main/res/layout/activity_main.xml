<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101113">

    <!-- Subtle Top Spacing -->
    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Conversation List Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_chats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#1A1C20"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#3D414A"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:text="no conversations"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Line Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1C20" />

    <!-- Bottom Terminal Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:background="#101113">

        <!-- [+] new action -->
        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="#A0A4AD"
            android:textSize="13sp"
            android:text="[+] new" />

        <!-- Status indicator dot (center-right) -->
        <View
            android:id="@+id/view_status_dot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginLeft="14dp"
            android:background="@drawable/badge_unread" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="1dp" />

        <!-- Quick Refresh -->
        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingRight="16dp"
            android:textColor="#555A64"
            android:textSize="13sp"
            android:text="sync" />

        <!-- Settings link -->
        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="#555A64"
            android:textSize="13sp"
            android:text="settings" />
    </LinearLayout>

    <!-- Hidden compatibility stub to prevent null-pointer in java code -->
    <LinearLayout
        android:id="@+id/layout_status_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <View android:id="@+id/banner_dot" android:layout_width="0dp" android:layout_height="0dp"/>
        <TextView android:id="@+id/tv_status_banner" android:layout_width="0dp" android:layout_height="0dp"/>
        <TextView android:id="@+id/btn_banner_action" android:layout_width="0dp" android:layout_height="0dp"/>
    </LinearLayout>

</LinearLayout>
