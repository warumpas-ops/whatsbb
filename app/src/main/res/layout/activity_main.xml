<?xml version="1.0" encoding="utf-8"?>
<!-- Real WhatsApp style — dark header, clean list, no boxy "card" feel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wa_bg">

    <!-- Header — real WA proportions, no buttons with emoji -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/wa_header"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="WhatsApp"
            android:textColor="@color/wa_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Status dot (tiny, inline with title) -->
        <View
            android:id="@+id/view_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/badge_unread" />

        <!-- Header action buttons as text, not emoji -->
        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="20sp"
            android:text="&#8635;" />

        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="24sp"
            android:text="&#43;" />

        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="18sp"
            android:text="&#8942;" />
    </LinearLayout>

    <!-- Status banner (only visible when not connected) -->
    <LinearLayout
        android:id="@+id/layout_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1A2E38"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:id="@+id/banner_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginRight="9dp"
            android:background="@drawable/badge_unread" />

        <TextView
            android:id="@+id/tv_status_banner"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_text_sub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_banner_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="12dp"
            android:text="PAIR" />
    </LinearLayout>

    <!-- Chat list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_chats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/wa_divider"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:text="No chats yet.\nTap + or refresh."
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
