<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wa_bg">

    <!-- Top WhatsApp Bar -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/wa_header"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="WhatsApp"
            android:textColor="@color/wa_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Status indicator dot (small) -->
        <View
            android:id="@+id/view_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/badge_unread" />

        <!-- Refresh action -->
        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="20sp"
            android:text="&#8635;" />

        <!-- Settings / Overflow Menu -->
        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="18sp"
            android:text="&#8942;" />
    </LinearLayout>

    <!-- Classic WhatsApp Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@color/wa_header">

        <!-- CHATS TAB (Active) -->
        <LinearLayout
            android:id="@+id/tab_chats"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_tab_chats_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHATS"
                    android:textColor="@color/wa_tab_active"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tab_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:minWidth="16dp"
                    android:layout_marginLeft="6dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:background="@drawable/badge_unread"
                    android:gravity="center"
                    android:textColor="#0B141B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Active tab indicator line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/wa_tab_active" />
        </LinearLayout>

        <!-- STATUS TAB -->
        <LinearLayout
            android:id="@+id/tab_status"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="STATUS"
                android:textColor="@color/wa_tab_inactive"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#00000000" />
        </LinearLayout>

        <!-- CALLS TAB -->
        <LinearLayout
            android:id="@+id/tab_calls"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="CALLS"
                android:textColor="@color/wa_tab_inactive"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#00000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- Disconnected Banner (only shows when offline) -->
    <LinearLayout
        android:id="@+id/layout_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1F2C34"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:id="@+id/banner_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginRight="9dp"
            android:background="@drawable/badge_unread" />

        <TextView
            android:id="@+id/tv_status_banner"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_text_sub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_banner_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="12dp"
            android:text="PAIR" />
    </LinearLayout>

    <!-- Chats List Area with Floating Action Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_chats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/wa_divider"
            android:dividerHeight="0.8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:text="No conversations yet.\nTap the green button to start a chat."
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Floating Action Button (FAB) — Real WhatsApp New Chat Button -->
        <FrameLayout
            android:id="@+id/btn_new_chat"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_fab">

            <!-- Chat icon (speech bubble shape) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:text="&#9993;" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
