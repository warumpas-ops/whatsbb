<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="#000000"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="WhatsBB"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <!-- Status dot -->
        <View
            android:id="@+id/view_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginRight="14dp"
            android:background="@drawable/badge_unread" />

        <!-- Refresh icon -->
        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="#4A4A4A"
            android:textSize="20sp"
            android:text="&#8635;" />

        <!-- Settings icon -->
        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="#4A4A4A"
            android:textSize="22sp"
            android:text="&#8942;" />
    </LinearLayout>

    <!-- Hairline separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#141414" />

    <!-- Offline / QR Banner -->
    <LinearLayout
        android:id="@+id/layout_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0A0A0A"
        android:paddingLeft="20dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:id="@+id/banner_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/badge_unread" />

        <TextView
            android:id="@+id/tv_status_banner"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_banner_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:paddingLeft="12dp"
            android:text="Pair" />
    </LinearLayout>

    <!-- Chat list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_chats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#0F0F0F"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#333333"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:text="No conversations yet"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Compose FAB — clean white circle -->
        <FrameLayout
            android:id="@+id/btn_new_chat"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/btn_fab">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="26sp"
                android:paddingBottom="2dp"
                android:text="&#43;" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
