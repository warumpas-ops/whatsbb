<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F10">

    <!-- Orbit-style Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#141416"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="8dp">

        <!-- App title -->
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="WhatsBB"
            android:textColor="#F2F2F2"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Status dot -->
        <View
            android:id="@+id/view_status_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/badge_unread" />

        <!-- [refresh] text button -->
        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="#808086"
            android:textSize="12sp"
            android:text="[refresh]" />

        <!-- [settings] text button -->
        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="#808086"
            android:textSize="12sp"
            android:text="[settings]" />
    </LinearLayout>

    <!-- Hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252528" />

    <!-- Offline Banner -->
    <LinearLayout
        android:id="@+id/layout_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#141416"
        android:paddingLeft="16dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:id="@+id/banner_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/badge_unread" />

        <TextView
            android:id="@+id/tv_status_banner"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#808086"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_banner_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F2F2F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingLeft="10dp"
            android:text="[pair]" />
    </LinearLayout>

    <!-- Second hairline when banner visible -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252528" />

    <!-- Chat List Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_chats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#252528"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#808086"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:text="No conversations yet.\nTap [+] below to start."
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Orbit-style [+] button, bottom right -->
        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="18dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#F2F2F2"
            android:textSize="13sp"
            android:text="[new chat]" />
    </FrameLayout>

</LinearLayout>
