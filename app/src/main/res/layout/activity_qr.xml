<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101113">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#101113"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btn_qr_back"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="#555A64"
            android:textSize="20sp"
            android:text="&#8592;" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="link device"
            android:textColor="#E0E2E6"
            android:textSize="16sp"
            android:layout_marginLeft="6dp" />

        <TextView
            android:id="@+id/btn_qr_settings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1C20" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#555A64"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:text="qr code" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#424650"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="WhatsApp > Linked Devices > Link a Device" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="20dp"
                android:background="#FFFFFF"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <ProgressBar
                    android:id="@+id/progress_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_qr_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#555A64"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:text="Waiting for QR code..." />

            <TextView
                android:id="@+id/btn_qr_refresh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:textColor="#A0A4AD"
                android:textSize="13sp"
                android:text="[reload QR]" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
