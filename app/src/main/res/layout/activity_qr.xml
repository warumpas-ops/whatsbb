<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bb_dark_bg">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bb_header_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <Button
            android:id="@+id/btn_qr_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="&#8592;"
            android:textColor="@color/bb_text_primary"
            android:textSize="20sp"
            android:background="@drawable/list_item_selector" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/btn_qr_back"
            android:layout_centerVertical="true"
            android:text="Link WhatsApp"
            android:textColor="@color/bb_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="6dp" />

        <Button
            android:id="@+id/btn_qr_settings"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="&#9881;"
            android:textColor="@color/bb_text_primary"
            android:textSize="18sp"
            android:background="@drawable/list_item_selector" />
    </RelativeLayout>

    <!-- QR Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="Scan this code from WhatsApp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="WhatsApp > Linked Devices > Link a Device" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                android:background="#ffffff"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <ProgressBar
                    android:id="@+id/progress_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_qr_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb_green"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:text="Waiting for QR code..." />

            <Button
                android:id="@+id/btn_qr_refresh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:textColor="@color/bb_text_primary"
                android:text="Reload QR"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
