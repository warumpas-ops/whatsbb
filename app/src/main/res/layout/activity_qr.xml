<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wa_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/wa_header"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/btn_qr_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text"
            android:textSize="22sp"
            android:text="&#8592;" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Link a Device"
            android:textColor="@color/wa_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="4dp" />

        <TextView
            android:id="@+id/btn_qr_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="18sp"
            android:text="&#8942;" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="Scan this code" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_sub"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="Open WhatsApp on your phone\nSettings > Linked Devices > Link a Device" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="20dp"
                android:background="#ffffff"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <ProgressBar
                    android:id="@+id/progress_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_qr_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_teal"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:text="Waiting for QR code..." />

            <TextView
                android:id="@+id/btn_qr_refresh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:textColor="@color/wa_text_sub"
                android:text="Reload QR"
                android:paddingLeft="20dp"
                android:paddingRight="20dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
