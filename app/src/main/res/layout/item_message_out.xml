<?xml version="1.0" encoding="utf-8"?>
<!-- Outgoing bubble — full-width row, bubble right-aligned -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:paddingLeft="72dp"
    android:paddingRight="6dp"
    android:orientation="vertical"
    android:gravity="right">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bubble_outgoing">

        <TextView
            android:id="@+id/tv_text_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_text"
            android:textSize="15sp"
            android:lineSpacingExtra="1dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <TextView
                android:id="@+id/tv_time_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_meta"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_status_ticks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:textColor="#53BDEB"
                android:textSize="12sp"
                android:text="&#10003;&#10003;" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
