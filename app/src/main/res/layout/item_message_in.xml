<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming bubble — full-width row, bubble left-aligned -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:paddingLeft="6dp"
    android:paddingRight="72dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bubble_incoming">

        <TextView
            android:id="@+id/tv_sender_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#53BDEB"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingBottom="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_text_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_text"
            android:textSize="15sp"
            android:lineSpacingExtra="1dp" />

        <TextView
            android:id="@+id/tv_time_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:paddingTop="2dp"
            android:textColor="@color/wa_text_meta"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
