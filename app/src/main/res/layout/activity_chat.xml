<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F10">

    <!-- Orbit-style Chat Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#141416"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="8dp">

        <!-- [back] text button -->
        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textColor="#808086"
            android:textSize="12sp"
            android:text="[back]" />

        <!-- Avatar (letter or photo) -->
        <FrameLayout
            android:id="@+id/layout_chat_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="10dp">

            <ImageView
                android:id="@+id/iv_chat_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_chat_avatar_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#F2F2F2"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Name + subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_thread_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2F2F2"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_thread_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#808086"
                android:textSize="11sp"
                android:text="WhatsApp" />
        </LinearLayout>

        <!-- [refresh] text button -->
        <TextView
            android:id="@+id/btn_chat_refresh"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="6dp"
            android:textColor="#808086"
            android:textSize="12sp"
            android:text="[refresh]" />
    </LinearLayout>

    <!-- Hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252528" />

    <!-- Message list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="4dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_chat_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#808086"
            android:textSize="13sp"
            android:text="No messages yet.\nType below to begin."
            android:visibility="gone" />
    </FrameLayout>

    <!-- Hairline above input -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252528" />

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#141416"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edit_message"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:maxLines="5"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/input_pill_bg"
            android:textColor="#F2F2F2"
            android:textColorHint="#606066"
            android:hint="Message..."
            android:textSize="14sp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- [send] text button -->
        <TextView
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#F2F2F2"
            android:textSize="12sp"
            android:text="[send]" />
    </LinearLayout>

</LinearLayout>
