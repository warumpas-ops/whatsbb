<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Chat header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="#000000"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="10dp">

        <!-- Back arrow -->
        <TextView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:text="&#8592;" />

        <!-- Avatar -->
        <FrameLayout
            android:id="@+id/layout_chat_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginRight="12dp">

            <ImageView
                android:id="@+id/iv_chat_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_chat_avatar_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Name + subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_thread_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_thread_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3A3A3A"
                android:textSize="11sp"
                android:text="WhatsApp" />
        </LinearLayout>

        <!-- Refresh -->
        <TextView
            android:id="@+id/btn_chat_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="#3A3A3A"
            android:textSize="20sp"
            android:text="&#8635;" />
    </LinearLayout>

    <!-- Hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#141414" />

    <!-- Messages -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_chat_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#333333"
            android:textSize="14sp"
            android:text="No messages"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Hairline above input -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#141414" />

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#000000"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edit_message"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:maxLines="5"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/input_pill_bg"
            android:textColor="#EEEEEE"
            android:textColorHint="#2E2E2E"
            android:hint="Message"
            android:textSize="14sp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- Send circle -->
        <FrameLayout
            android:id="@+id/btn_send"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/btn_send_circle">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingLeft="2dp"
                android:text="&#10148;" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
