<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wa_chat_bg">

    <!-- WhatsApp Conversation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/wa_header"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="8dp">

        <!-- Combined Back + Avatar Click Area -->
        <LinearLayout
            android:id="@+id/layout_header_back_avatar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/wa_text"
                android:textSize="22sp"
                android:text="&#8592;" />

            <!-- Circular Avatar -->
            <FrameLayout
                android:id="@+id/layout_chat_avatar"
                android:layout_width="38dp"
                android:layout_height="38dp">

                <TextView
                    android:id="@+id/tv_chat_avatar_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Name + Online Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="6dp">

            <TextView
                android:id="@+id/tv_thread_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_thread_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_online"
                android:textSize="12sp"
                android:text="online" />
        </LinearLayout>

        <!-- Refresh / More Options -->
        <TextView
            android:id="@+id/btn_chat_refresh"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="20sp"
            android:text="&#8635;" />
    </LinearLayout>

    <!-- Message Bubble Stream Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="3dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_chat_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/wa_text_sub"
            android:textSize="14sp"
            android:text="No messages here yet.\nSay hello!"
            android:visibility="gone" />
    </FrameLayout>

    <!-- WhatsApp Iconic Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:gravity="bottom">

        <!-- Rounded Input Pill Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:background="@drawable/input_pill_bg"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <!-- Smiley Emoji Icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_sub"
                android:textSize="20sp"
                android:layout_marginRight="8dp"
                android:text="&#9786;" />

            <!-- Input Box -->
            <EditText
                android:id="@+id/edit_message"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:maxLines="5"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#00000000"
                android:textColor="@color/wa_text"
                android:textColorHint="@color/wa_text_sub"
                android:hint="Message"
                android:textSize="15sp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine" />

            <!-- Paperclip Attach Icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_sub"
                android:textSize="19sp"
                android:paddingLeft="6dp"
                android:text="&#128206;" />
        </LinearLayout>

        <!-- Floating Green Send Button (Circle) -->
        <FrameLayout
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/btn_send_circle">

            <!-- Send Paper Airplane Arrow -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:paddingLeft="2dp"
                android:text="&#10148;" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
