<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101113">

    <!-- Clean Header: just back arrow + contact name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="16dp"
        android:background="#101113">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#555A64"
            android:textSize="20sp"
            android:text="&#8592;" />

        <TextView
            android:id="@+id/tv_thread_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#E0E2E6"
            android:textSize="16sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginLeft="6dp" />

        <TextView
            android:id="@+id/btn_chat_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="#555A64"
            android:textSize="16sp"
            android:text="&#8635;" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1C20" />

    <!-- Conversation Stream -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="6dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_chat_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#3D414A"
            android:textSize="13sp"
            android:text="no messages"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1C20" />

    <!-- Clean Bottom Input Line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#101113"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edit_message"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:maxLines="5"
            android:paddingLeft="0dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@null"
            android:textColor="#E0E2E6"
            android:textColorHint="#424650"
            android:hint="Type a message..."
            android:textSize="14sp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine" />

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="6dp"
            android:textColor="#A0A4AD"
            android:textSize="13sp"
            android:text="send &#8593;" />
    </LinearLayout>

    <!-- Hidden compatibility stubs -->
    <FrameLayout
        android:id="@+id/layout_chat_avatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageView android:id="@+id/iv_chat_avatar" android:layout_width="0dp" android:layout_height="0dp"/>
        <TextView android:id="@+id/tv_chat_avatar_letter" android:layout_width="0dp" android:layout_height="0dp"/>
    </FrameLayout>
    <TextView android:id="@+id/tv_thread_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</LinearLayout>
