<?xml version="1.0" encoding="utf-8"?>
<!--
  WhatsBB v1.7 Chat Screen
  ─────────────────────────
  Header: just back arrow + name. NO subtitle. NO app watermark.
  Bubbles: incoming = #111111 + 2dp left edge, outgoing = #1A1A1A
  Input: borderless dark pill, white send circle
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A">

    <!-- Minimal header — no subtitle, avatar prominent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="#0A0A0A"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#444444"
            android:textSize="24sp"
            android:text="&#8592;" />

        <FrameLayout
            android:id="@+id/layout_chat_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="12dp">

            <ImageView
                android:id="@+id/iv_chat_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_chat_avatar_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Name only — no subtitle -->
        <TextView
            android:id="@+id/tv_thread_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#EEEEEE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Keep view IDs required by Java but hidden -->
        <TextView
            android:id="@+id/tv_thread_status"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_chat_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="#222222"
            android:textSize="18sp"
            android:text="&#8635;" />
    </LinearLayout>

    <!-- Thin separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#111111" />

    <!-- Message list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_chat_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#1E1E1E"
            android:textSize="14sp"
            android:letterSpacing="0.06"
            android:text="no messages yet"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Input bar — clean, no top border visible -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0A0A0A"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edit_message"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:maxLines="5"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:background="@drawable/input_pill_bg"
            android:textColor="#DDDDDD"
            android:textColorHint="#222222"
            android:hint="Message"
            android:textSize="14sp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- Send: white circle -->
        <FrameLayout
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/btn_send_circle">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingLeft="2dp"
                android:text="&#10148;" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
