<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Incoming Container (Left-aligned) -->
    <LinearLayout
        android:id="@+id/layout_bubble_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:maxWidth="280dp"
        android:layout_marginRight="40dp"
        android:orientation="vertical"
        android:background="@drawable/bubble_incoming"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_sender_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#53bdeb"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_text_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bb_text_primary"
            android:textSize="15sp"
            android:text="Incoming message text" />

        <TextView
            android:id="@+id/tv_time_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="2dp"
            android:textColor="@color/bb_text_time"
            android:textSize="10sp"
            android:text="12:00" />
    </LinearLayout>

    <!-- Outgoing Container (Right-aligned) -->
    <LinearLayout
        android:id="@+id/layout_bubble_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:maxWidth="280dp"
        android:layout_marginLeft="40dp"
        android:orientation="vertical"
        android:background="@drawable/bubble_outgoing"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_text_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bb_text_primary"
            android:textSize="15sp"
            android:text="Outgoing message text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_time_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb_text_time"
                android:textSize="10sp"
                android:text="12:01" />

            <TextView
                android:id="@+id/tv_status_ticks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:textColor="#53bdeb"
                android:textSize="11sp"
                android:text="&#10003;&#10003;" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
