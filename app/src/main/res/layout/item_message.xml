<?xml version="1.0" encoding="utf-8"?>
<!-- Real WhatsApp message bubble item -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <!-- INCOMING bubble (left-aligned) -->
    <LinearLayout
        android:id="@+id/layout_bubble_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="64dp"
        android:orientation="vertical"
        android:background="@drawable/bubble_incoming"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_sender_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_link"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_text_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_text"
            android:textSize="15sp"
            android:lineSpacingExtra="1dp" />

        <TextView
            android:id="@+id/tv_time_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:paddingTop="1dp"
            android:textColor="@color/wa_text_meta"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- OUTGOING bubble (right-aligned) -->
    <LinearLayout
        android:id="@+id/layout_bubble_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginLeft="64dp"
        android:layout_marginRight="4dp"
        android:orientation="vertical"
        android:background="@drawable/bubble_outgoing"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_text_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_text"
            android:textSize="15sp"
            android:lineSpacingExtra="1dp" />

        <!-- Time + tick row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="1dp">

            <TextView
                android:id="@+id/tv_time_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_meta"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_status_ticks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:textColor="#53BDEB"
                android:textSize="12sp"
                android:text="&#10003;&#10003;" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
