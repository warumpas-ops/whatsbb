<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- INCOMING bubble — left aligned -->
    <LinearLayout
        android:id="@+id/layout_bubble_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|center_vertical"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="72dp"
        android:orientation="vertical"
        android:background="@drawable/bubble_incoming">

        <TextView
            android:id="@+id/tv_sender_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#53BDEB"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingBottom="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_text_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_text"
            android:textSize="15sp"
            android:lineSpacingExtra="1dp" />

        <TextView
            android:id="@+id/tv_time_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:paddingTop="2dp"
            android:textColor="@color/wa_text_meta"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- OUTGOING bubble — right aligned -->
    <LinearLayout
        android:id="@+id/layout_bubble_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:layout_marginLeft="72dp"
        android:layout_marginRight="6dp"
        android:orientation="vertical"
        android:background="@drawable/bubble_outgoing">

        <TextView
            android:id="@+id/tv_text_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_text"
            android:textSize="15sp"
            android:lineSpacingExtra="1dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <TextView
                android:id="@+id/tv_time_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_meta"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_status_ticks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:textColor="#53BDEB"
                android:textSize="12sp"
                android:text="&#10003;&#10003;" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
