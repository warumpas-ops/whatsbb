<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wa_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/wa_header"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/btn_settings_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@color/wa_text"
            android:textSize="22sp"
            android:text="&#8592;" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/wa_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Bridge URL section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BRIDGE SERVER"
                android:textColor="@color/wa_teal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address of the WhatsBB companion bridge running on your PC or Raspberry Pi"
                android:textColor="@color/wa_text_sub"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp" />

            <EditText
                android:id="@+id/edit_server_url"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/input_bg"
                android:textColor="@color/wa_text"
                android:textColorHint="@color/wa_text_sub"
                android:hint="http://192.168.1.5:3000"
                android:singleLine="true"
                android:inputType="textUri"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/btn_save_url"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:background="@drawable/btn_send"
                    android:text="Save"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_test_connection"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/input_bg"
                    android:text="Ping"
                    android:textColor="@color/wa_text_sub"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/wa_text_sub"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/wa_divider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

            <!-- Account section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT"
                android:textColor="@color/wa_teal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/btn_link_qr"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_bg"
                android:text="  Pair Device (Scan QR Code)"
                android:textColor="@color/wa_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:text="  Unpair / Log Out"
                android:textColor="@color/wa_red"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/wa_divider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABOUT"
                android:textColor="@color/wa_teal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_sub"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="WhatsBB v1.1 for BlackBerry 10\nQ5 · Q10 · Classic · Passport · Z10 · Z30\nUses WhatsApp Multi-Device (Linked Devices) protocol." />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
