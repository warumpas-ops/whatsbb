<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101113">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="16dp"
        android:background="#101113">

        <TextView
            android:id="@+id/btn_settings_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#555A64"
            android:textSize="20sp"
            android:text="&#8592;" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="settings"
            android:textColor="#E0E2E6"
            android:textSize="15sp"
            android:typeface="monospace"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1C20" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Gateway -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gateway"
                android:textColor="#555A64"
                android:textSize="12sp"
                android:letterSpacing="0.05" />

            <EditText
                android:id="@+id/edit_server_url"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:paddingLeft="0dp"
                android:background="@null"
                android:textColor="#E0E2E6"
                android:textColorHint="#424650"
                android:hint="http://192.168.1.5:3000"
                android:singleLine="true"
                android:inputType="textUri"
                android:textSize="13sp"
                android:typeface="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btn_save_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[save]"
                    android:textColor="#A0A4AD"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:paddingRight="16dp" />

                <TextView
                    android:id="@+id/btn_test_connection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[test connection]"
                    android:textColor="#A0A4AD"
                    android:textSize="13sp"
                    android:typeface="monospace" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#555A64"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A1C20"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- Actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="account"
                android:textColor="#555A64"
                android:textSize="12sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/btn_link_qr"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:text="[scan QR code]"
                android:textColor="#A0A4AD"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:text="[log out]"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:typeface="monospace" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A1C20"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="about"
                android:textColor="#555A64"
                android:textSize="12sp"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#424650"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="WhatsBB Minimalist Terminal Edition\nBlackBerry 10 (Passport, Classic, Q10, Q5, Z10, Z30)" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
